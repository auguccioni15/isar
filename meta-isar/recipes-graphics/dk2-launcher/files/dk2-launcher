#!/usr/bin/env python3
# dk2-launcher — fullscreen GTK3 application launcher with large icons.
#
# Shows a grid of big icon tiles, one per .desktop file found in
# /etc/dk2-launcher/apps/. Clicking a tile launches that application.
# Add or remove .desktop files in that directory to change the grid;
# no need to edit this script. Press Escape/F5 to reload (systemd
# restarts a fresh instance, picking up new .desktop files).
#
# Started as a systemd service under Weston (see dk2-launcher.service).

import os
import shlex
import subprocess
import gi

gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gio, Gdk, GdkPixbuf, GLib  # noqa: E402

APPS_DIR = '/etc/dk2-launcher/apps'
# Tile icons are rendered at this exact size (width x height, px).
ICON_WIDTH = 40
ICON_HEIGHT = 30
COLUMNS = 3

CSS = b"""
.dk2-bg { background-color: #1c1f26; }
.dk2-tile {
    background-image: none;
    background-color: #2a2f3a;
    border: none;
    border-radius: 16px;
    padding: 20px;
}
.dk2-tile:hover { background-color: #3a4252; }
.dk2-label { color: #e6e6e6; font-size: 16px; }
"""


def load_apps():
    apps = []
    try:
        names = sorted(os.listdir(APPS_DIR))
    except OSError:
        names = []
    for name in names:
        if not name.endswith('.desktop'):
            continue
        info = Gio.DesktopAppInfo.new_from_filename(
            os.path.join(APPS_DIR, name))
        if info is not None:
            apps.append(info)
    return apps


class Launcher(Gtk.Window):
    def __init__(self):
        super().__init__(title='DK2 Launcher')
        self.connect('destroy', Gtk.main_quit)
        self.connect('key-press-event', self.on_key)
        self.fullscreen()
        self.get_style_context().add_class('dk2-bg')

        flow = Gtk.FlowBox()
        flow.set_valign(Gtk.Align.START)
        flow.set_halign(Gtk.Align.CENTER)
        flow.set_max_children_per_line(COLUMNS)
        flow.set_min_children_per_line(1)
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        flow.set_row_spacing(28)
        flow.set_column_spacing(28)
        flow.set_margin_top(40)
        flow.set_margin_bottom(40)
        flow.set_margin_start(40)
        flow.set_margin_end(40)

        apps = load_apps()
        if apps:
            for info in apps:
                flow.add(self.make_tile(info))
        else:
            flow.add(Gtk.Label(label='No applications in %s' % APPS_DIR))

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.get_style_context().add_class('dk2-bg')
        scroller.add(flow)
        self.add(scroller)

    @staticmethod
    def load_icon_pixbuf(icon):
        # Render the themed icon to an exact ICON_WIDTH x ICON_HEIGHT pixbuf.
        # Gtk.Image.set_pixel_size() only does square icons, so look the icon
        # up in the theme and scale the pixbuf ourselves to honour the
        # non-square tile size.
        theme = Gtk.IconTheme.get_default()
        size = max(ICON_WIDTH, ICON_HEIGHT)
        icon_info = None
        if icon is not None:
            icon_info = theme.lookup_by_gicon(icon, size, 0)
        if icon_info is None:
            icon_info = theme.lookup_icon(
                'application-x-executable', size, 0)
        if icon_info is None:
            return None
        try:
            pixbuf = icon_info.load_icon()
        except GLib.Error:
            return None
        return pixbuf.scale_simple(
            ICON_WIDTH, ICON_HEIGHT, GdkPixbuf.InterpType.BILINEAR)

    def make_tile(self, info):
        button = Gtk.Button()
        button.get_style_context().add_class('dk2-tile')
        button.connect('clicked', self.on_click, info)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        image = Gtk.Image()
        pixbuf = self.load_icon_pixbuf(info.get_icon())
        if pixbuf is not None:
            image.set_from_pixbuf(pixbuf)
        else:
            image.set_from_icon_name(
                'application-x-executable', Gtk.IconSize.DIALOG)
            image.set_pixel_size(max(ICON_WIDTH, ICON_HEIGHT))

        label = Gtk.Label(label=info.get_display_name())
        label.get_style_context().add_class('dk2-label')

        box.pack_start(image, False, False, 0)
        box.pack_start(label, False, False, 0)
        button.add(box)
        return button

    def on_click(self, button, info):
        # Launch the Exec line directly via subprocess rather than
        # Gio.DesktopAppInfo.launch(): under a bare systemd service (no D-Bus
        # session bus) GIO tries to start the app in a systemd scope and
        # fails silently, so nothing happens on tap. subprocess inherits our
        # environment (WAYLAND_DISPLAY/XDG_RUNTIME_DIR/GDK_BACKEND set by the
        # unit), which is all a Wayland client needs.
        cmdline = info.get_commandline() or ''
        argv = [a for a in shlex.split(cmdline)
                if not (len(a) == 2 and a[0] == '%')]  # drop %U %f %i ...
        if not argv:
            print('dk2-launcher: no Exec line for %s'
                  % info.get_display_name(), flush=True)
            return
        print('dk2-launcher: launching %s' % argv, flush=True)
        try:
            # start_new_session detaches the child into its own session so it
            # is not tied to the launcher's controlling tty and survives on
            # its own.
            proc = subprocess.Popen(argv, env=os.environ.copy(),
                                    start_new_session=True)
        except OSError as exc:
            print('dk2-launcher: failed to launch %s: %s' % (argv, exc),
                  flush=True)
            return
        # A Wayland client that crashes on startup returns from Popen just
        # fine, so "the tile flashes but nothing appears" looks identical to
        # a successful launch. Check back shortly and log a non-zero early
        # exit so the real failure shows up in `journalctl -u dk2-launcher`.
        GLib.timeout_add(800, self._report_early_exit, proc, argv)

    @staticmethod
    def _report_early_exit(proc, argv):
        rc = proc.poll()
        if rc is not None and rc != 0:
            print('dk2-launcher: %s exited immediately (code %d)'
                  % (argv, rc), flush=True)
        return False  # one-shot timeout

    def on_key(self, widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_F5):
            Gtk.main_quit()
        return False


def main():
    # Create the window first: that triggers GTK init and opens the display,
    # so the window has a valid GdkScreen. Calling Gdk.Screen.get_default()
    # before any widget exists returns None and crashes add_provider_for_screen.
    win = Launcher()

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        win.get_screen(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    win.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
